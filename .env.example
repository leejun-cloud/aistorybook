# Gemini API 키 (필수) — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your-gemini-api-key

# 선택: 모델 오버라이드
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_STORY_MODEL=            # 스토리 초안·게이트 전용 상위 모델 (pro 계열 권장)
# STORY_DRAFT_CANDIDATES=2       # best-of-N 초안 수 (1~4)

# 이용권 결제 (토스페이먼츠 단건). 없으면 제작은 되고 인쇄용 다운로드만 잠긴다.
# 클라이언트 키는 /api/credits/order 응답으로 내려주므로 NEXT_PUBLIC_ 접두사가 필요 없다 —
# lib/payments/config.ts가 아래 이름들을 순서대로 찾는다.
VITE_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 사업자 정보 — 전자상거래법 제10조(사업자 정보 표시) 의무 항목.
# 값이 비어 있으면 화면에 "(미등록)"으로 표시되고, 결제 버튼이 열리지 않는다.
# 서비스명은 사업자 정보가 아니라 앱 식별자라 lib/legal/business.ts에 고정돼 있다.
VITE_BIZ_COMPANY_NAME=
VITE_BIZ_CEO=
VITE_BIZ_REG_NO=
VITE_BIZ_MAILORDER_NO=
VITE_BIZ_ADDRESS=
VITE_BIZ_PHONE=
VITE_BIZ_EMAIL=
VITE_BIZ_HOST=
VITE_BIZ_COURT=
# Firebase 인증 — 로그인이 있어야 이용권이 사용자별로 분리된다.
# 이 값들이 없으면 로그인 없이 동작하고(단일 공용 계정), 결제는 열리지 않는다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 서버에서 ID 토큰을 검증하는 서비스계정 (base64 JSON)
FIREBASE_SERVICE_ACCOUNT_B64=
# 기존 프로젝트(소유자 없음)를 볼 수 있는 운영자 계정 이메일
MASTER_EMAIL=
