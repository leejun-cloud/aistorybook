# Gemini API 키 (필수) — https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=your-gemini-api-key

# 선택: 모델 오버라이드
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_STORY_MODEL=            # 스토리 초안·게이트 전용 상위 모델 (pro 계열 권장)
# STORY_DRAFT_CANDIDATES=2       # best-of-N 초안 수 (1~4)

# 이용권 결제 (토스페이먼츠 단건). 없으면 제작은 되고 인쇄용 다운로드만 잠긴다.
# 클라이언트 키는 /api/credits/order 응답으로 내려주므로 NEXT_PUBLIC_ 접두사가 필요 없다 —
# lib/payments/config.ts가 아래 이름들을 순서대로 찾는다.
VITE_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
